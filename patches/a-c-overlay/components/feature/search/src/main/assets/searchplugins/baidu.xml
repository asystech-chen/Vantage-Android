<SearchPlugin xmlns="http://www.mozilla.org/2006/browser/search/">
<ShortName>百度</ShortName>
<Description>百度搜索</Description>
<InputEncoding>UTF-8</InputEncoding>
<Image width="32" height="32">data:image/png;base64,</Image>
<Url type="application/x-suggestions+json" method="GET" template="https://suggestion.baidu.com/su">
  <Param name="wd" value="{searchTerms}"/>
  <Param name="cb" value="callback"/>
  <Param name="t" value="1"/>
</Url>
<Url type="text/html" method="GET" template="https://www.baidu.com/s">
  <Param name="wd" value="{searchTerms}"/>
  <Param name="ie" value="UTF-8"/>
</Url>
<SearchForm>https://www.baidu.com/</SearchForm>
</SearchPlugin>
