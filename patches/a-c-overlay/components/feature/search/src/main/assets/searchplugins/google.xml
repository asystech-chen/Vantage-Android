<SearchPlugin xmlns="http://www.mozilla.org/2006/browser/search/">
<ShortName>Google</ShortName>
<Description>Google 搜索</Description>
<InputEncoding>UTF-8</InputEncoding>
<Image width="32" height="32">data:image/png;base64,</Image>
<Url type="application/x-suggestions+json" method="GET" template="https://suggestqueries.google.com/complete/search">
  <Param name="client" value="firefox"/>
  <Param name="q" value="{searchTerms}"/>
</Url>
<Url type="text/html" method="GET" template="https://www.google.com/search">
  <Param name="q" value="{searchTerms}"/>
  <Param name="ie" value="utf-8"/>
  <Param name="oe" value="utf-8"/>
</Url>
<SearchForm>https://www.google.com/</SearchForm>
</SearchPlugin>
