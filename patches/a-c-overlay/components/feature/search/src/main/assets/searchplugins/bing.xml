<SearchPlugin xmlns="http://www.mozilla.org/2006/browser/search/">
<ShortName>Bing</ShortName>
<Description>Bing 搜索 - 微软必应</Description>
<InputEncoding>UTF-8</InputEncoding>
<Image width="32" height="32">data:image/png;base64,</Image>
<Url type="application/x-suggestions+json" method="GET" template="https://www.bing.com/osjson.aspx">
  <Param name="query" value="{searchTerms}"/>
</Url>
<Url type="text/html" method="GET" template="https://www.bing.com/search">
  <Param name="q" value="{searchTerms}"/>
  <Param name="form" value="MOZAN1"/>
</Url>
<SearchForm>https://www.bing.com/</SearchForm>
</SearchPlugin>
