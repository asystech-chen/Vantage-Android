  <string name="updater_auto_download_confirm_message">发现更新后，Vantage 会立即通过任何网络连接（包括移动数据）下载。更新包最大约 200 MB。安装时机仍由您决定。</string>
  <string name="updater_auto_download_confirm_enable">开启</string>
