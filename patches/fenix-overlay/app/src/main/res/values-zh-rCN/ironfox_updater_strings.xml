  <!-- Updates settings -->
  <string name="updater_title">更新</string>
  <string name="updater_enabled_title">自动检查更新</string>
  <string name="updater_enabled_summary">Vantage 会向 Vantage 发布服务器检查新版本，并在安装前询问您。</string>
  <string name="updater_interval_title">检查间隔</string>
  <string name="updater_interval_summary">Vantage 检查更新的频率（小时）</string>
  <string name="updater_direct_downloads_title">直接下载更新</string>
  <string name="updater_direct_downloads_summary">使用 Vantage 下载并安装更新，而不是打开 %1$s。Android 可能会要求您确认从其他来源更新。</string>
  <string name="updater_auto_download_title">自动下载更新</string>
  <string name="updater_auto_download_summary">发现更新后，Vantage 会立即通过任何网络连接（包括移动数据）下载。更新包最大约 200 MB。</string>
  <string name="updater_auto_download_needs_direct_summary">请先开启“直接下载更新”。</string>
