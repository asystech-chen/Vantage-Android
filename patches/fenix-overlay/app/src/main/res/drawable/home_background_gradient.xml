<?xml version="1.0" encoding="utf-8"?>
<!-- Vantage: the edge-to-edge homepage background is white in light mode and keeps the
     original dark blue gradient in dark mode. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="@color/vantage_home_gradient_start"
        android:endColor="@color/vantage_home_gradient_end"
        android:useLevel="false" />
</shape>
