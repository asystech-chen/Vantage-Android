<?xml version="1.0" encoding="utf-8"?>
<!-- Vantage: branded round icon (white orb + gradient ring + V). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="600"
    android:viewportHeight="600">
    <!-- 鐧借壊涓诲渾 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M60,300a240,240 0 1,0 480,0a240,240 0 1,0 -480,0" />
    <!-- 澶栫幆 -->
    <path
        android:pathData="M62,300a238,238 0 1,0 476,0a238,238 0 1,0 -476,0"
        android:strokeWidth="3"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="600"
                android:endY="600"
                android:type="linear">
                <item android:offset="0" android:color="#6660A5FA" />
                <item android:offset="1" android:color="#662DD4BF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 鍐呯幆 -->
    <path
        android:pathData="M75,300a225,225 0 1,0 450,0a225,225 0 1,0 -450,0"
        android:strokeWidth="2"
        android:strokeColor="#80E2E8F0"
        android:fillColor="#00000000" />
    <!-- V -->
    <path
        android:pathData="M175,195 L300,435 L425,195"
        android:strokeWidth="75"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="137.5"
                android:startY="159"
                android:endX="462.5"
                android:endY="471"
                android:type="linear">
                <item android:offset="0.1154" android:color="#3B82F6" />
                <item android:offset="0.4231" android:color="#2563EB" />
                <item android:offset="0.6538" android:color="#2DD4BF" />
                <item android:offset="0.8846" android:color="#14B8A6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
