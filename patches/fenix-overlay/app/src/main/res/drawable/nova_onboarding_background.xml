<?xml version="1.0" encoding="utf-8"?>
<!-- Vantage: desktop-style onboarding backdrop (charcoal gradient, no wallpaper). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="192dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path android:pathData="M0,0h100v100h-100z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="100"
                android:type="linear">
                <item
                    android:offset="0"
                    android:color="#FF1C1B22" />
                <item
                    android:offset="1"
                    android:color="#FF23222B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
