<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/vantage_slots_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/top_bar_alignment_margin_start"
        android:text="@string/preferences_toolbar_select_shortcut"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

    <LinearLayout
        android:id="@+id/vantage_slots_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/top_bar_alignment_margin_start"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/top_bar_alignment_margin_start"
        android:background="@drawable/vantage_slots_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <FrameLayout
            android:id="@+id/vantage_slot_1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/vantage_slot_icon_1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/vantage_slot_2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/vantage_slot_icon_2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/vantage_slot_3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/vantage_slot_icon_3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Matches the real expanded toolbar: tab counter (live count) + overflow menu. -->
        <TextView
            android:id="@+id/vantage_slots_tab_counter"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/vantage_tab_counter_bg"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="&#8942;"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="20sp"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
