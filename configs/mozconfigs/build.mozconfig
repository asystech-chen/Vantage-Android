# shellcheck shell=bash
# IronFox build mozconfig

set -euo pipefail

# This mozconfig is home to arguments that are only necessary when the compile environment is enabled
# (translation: when --disable-compile-environment is not set)
# These are necessary to set in a different file, because setting --disable-compile-environment argument with them present results in build errors

# We're building, so enable the compile environment
ac_add_options --enable-compile-environment

# Allow replacing the malloc implementation
ac_add_options --enable-replace-malloc

# Disable build cache
ac_add_options --without-ccache
export CCACHE=

# Disable misc. debugging/development/test features
ac_add_options --disable-debug-symbols
ac_add_options --disable-geckodriver
ac_add_options --disable-gtest-in-build
ac_add_options --disable-phc
ac_add_options --disable-rust-debug
ac_add_options --disable-rust-tests
export MOZ_DEBUG_FLAGS=
export MOZ_PHC=

## Disable Rust incremental compilation
### (Ensures builds are fresh)
### https://doc.rust-lang.org/cargo/reference/profiles.html#incremental
ac_add_options --disable-cargo-incremental

# Do not build with the Android GoogleVR SDK
ac_add_options --without-android-googlevr-sdk

# Enable misc. security hardening
ac_add_options --enable-hardening
ac_add_options --enable-stl-hardening
export MOZ_SECURITY_HARDENING=1

# Enable performance optimizations
if [[ "${IRONFOX_DEV:-0}" == '1' ]]; then
  # Dev build: no LTO, -O1. Optimize for compile speed, not runtime performance.
  ac_add_options --disable-lto
  unset MOZ_LTO
  export MOZ_LTO=
  IRONFOX_BUILD_COMPILER_FLAGS_TMP="${IRONFOX_COMPILER_FLAGS//-flto=full/}"
  IRONFOX_BUILD_COMPILER_FLAGS_TMP="${IRONFOX_BUILD_COMPILER_FLAGS_TMP//-O3/-O1}"
  IRONFOX_BUILD_COMPILER_FLAGS_TMP="${IRONFOX_BUILD_COMPILER_FLAGS_TMP//-ftree-vectorize/}"
  readonly IRONFOX_BUILD_COMPILER_FLAGS="${IRONFOX_BUILD_COMPILER_FLAGS_TMP}"
  ac_add_options --enable-optimize='-O1'
  export MOZ_OPTIMIZE_FLAGS='-O1'
  export RUSTC_OPT_LEVEL=1
elif [[ "${IRONFOX_DISABLE_LTO:-0}" == '1' ]]; then
  # LTO is disabled for this build variant (the full-LTO link of libxul.so is
  # extremely memory hungry and slow; this trades some runtime performance for
  # a much faster build)
  ## Strip -flto from the default compiler flags, otherwise every object file would
  ## still be emitted as LLVM bitcode and the link would effectively be a full LTO link again
  ac_add_options --disable-lto
  unset MOZ_LTO
  export MOZ_LTO=
  readonly IRONFOX_BUILD_COMPILER_FLAGS="${IRONFOX_COMPILER_FLAGS//-flto=full/}"
  ac_add_options --enable-optimize='-O3 -ftree-vectorize'
  export MOZ_OPTIMIZE_FLAGS='-O3 -ftree-vectorize'
  export RUSTC_OPT_LEVEL=3
else
  ac_add_options --enable-lto='full'
  export MOZ_LTO='full'
  readonly IRONFOX_BUILD_COMPILER_FLAGS="${IRONFOX_COMPILER_FLAGS}"
  ac_add_options --enable-optimize='-O3 -ftree-vectorize'
  export MOZ_OPTIMIZE_FLAGS='-O3 -ftree-vectorize'
  export RUSTC_OPT_LEVEL=3
fi

# Enable stripping
ac_add_options --enable-install-strip
ac_add_options --enable-strip
export STRIP_FLAGS="--strip-debug --strip-unneeded"

# Set Android minimum SDK version
## https://searchfox.org/firefox-release/rev/3c71aeacdb296402e41fb2084b13e797d1770642/build/moz.configure/android-ndk.configure#34
ac_add_options --with-android-version="${IRONFOX_ANDROID_MIN_SDK}"

# Set Android NDK path
ac_add_options --with-android-ndk="${IRONFOX_ANDROID_NDK}"

# Set Clang/LLVM library paths
ac_add_options --with-libclang-path="${IRONFOX_LIBCLANG}"
ac_add_options CC="${IRONFOX_ANDROID_NDK}/toolchains/llvm/prebuilt/${IRONFOX_PLATFORM}-x86_64/bin/clang"
ac_add_options CXX="${IRONFOX_ANDROID_NDK}/toolchains/llvm/prebuilt/${IRONFOX_PLATFORM}-x86_64/bin/clang++"
ac_add_options STRIP="${IRONFOX_ANDROID_NDK}/toolchains/llvm/prebuilt/${IRONFOX_PLATFORM}-x86_64/bin/llvm-strip"
ac_add_options WASM_CC="${IRONFOX_WASI}/bin/clang"
ac_add_options WASM_CXX="${IRONFOX_WASI}/bin/clang++"

# Set compiler (toolchain) flags
export ASFLAGS="${IRONFOX_BUILD_COMPILER_FLAGS}"
export CFLAGS="${IRONFOX_BUILD_COMPILER_FLAGS}"
export CPPFLAGS="${IRONFOX_BUILD_COMPILER_FLAGS}"
export CXXFLAGS="${IRONFOX_BUILD_COMPILER_FLAGS}"
export HOST_CFLAGS="${IRONFOX_BUILD_COMPILER_FLAGS}"
export HOST_CPPFLAGS="${IRONFOX_BUILD_COMPILER_FLAGS}"
export HOST_CXXFLAGS="${IRONFOX_BUILD_COMPILER_FLAGS}"
export HOST_LDFLAGS="${IRONFOX_BUILD_COMPILER_FLAGS}"
export LDFLAGS="${IRONFOX_BUILD_COMPILER_FLAGS}"

# Set Rust flags
if [[ "${IRONFOX_DEV:-0}" == '1' ]]; then
  # Dev: lower opt level and keep incremental state for fast rebuilds.
  IRONFOX_DEV_RUST_FLAGS="${IRONFOX_RUST_FLAGS//-Copt-level=3/-Copt-level=1}"
  IRONFOX_DEV_RUST_FLAGS="${IRONFOX_DEV_RUST_FLAGS//-Cincremental=false/-Cincremental=true}"
  export RUSTDOCFLAGS="${IRONFOX_DEV_RUST_FLAGS} -Crelro-level=full"
  export RUSTFLAGS="${IRONFOX_DEV_RUST_FLAGS} -Crelro-level=full"
else
  export RUSTDOCFLAGS="${IRONFOX_RUST_FLAGS} -Crelro-level=full"
  export RUSTFLAGS="${IRONFOX_RUST_FLAGS} -Crelro-level=full"
fi

if [[ "${IRONFOX_DISABLE_LTO:-0}" == '1' ]]; then
  # Also disable Rust's LTO for this build variant (configs/cargo/config.toml enables it,
  ## and env vars take priority over that file)
  export CARGO_PROFILE_DEV_LTO=false
  export CARGO_PROFILE_RELEASE_LTO=false
fi

# Set WASI sysroot path
ac_add_options --with-wasi-sysroot="${IRONFOX_WASI}/share/wasi-sysroot"
export WASI_SYSROOT="${IRONFOX_WASI}/share/wasi-sysroot"

# Dev-specific overrides: reuse ccache, keep incremental state, don't strip.
if [[ "${IRONFOX_DEV:-0}" == '1' ]]; then
  . "${IRONFOX_MOZCONFIGS}/dev.mozconfig" || return 1
fi
