# shellcheck shell=bash
# Vantage Release

set -euo pipefail

. "${IRONFOX_MOZCONFIGS}/branding/common.mozconfig"

ac_add_options --enable-ironfox-release
ac_add_options --with-app-basename='Vantage'
ac_add_options --with-app-name='vantage'
ac_add_options --with-branding='ironfox/branding/ironfox'
export MOZ_APP_BASENAME='Vantage'
export MOZ_APP_NAME='vantage'
export MOZ_APP_REMOTINGNAME='vantage'
