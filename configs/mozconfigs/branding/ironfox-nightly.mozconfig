# shellcheck shell=bash
# Vantage Nightly

set -euo pipefail

. "${IRONFOX_MOZCONFIGS}/branding/common.mozconfig"

ac_add_options --disable-ironfox-release
ac_add_options --with-app-basename='Vantage Nightly'
ac_add_options --with-app-name='vantage-nightly'
ac_add_options --with-branding='ironfox/branding/ironfox-nightly'
export MOZ_APP_BASENAME='Vantage Nightly'
export MOZ_APP_NAME='vantage-nightly'
export MOZ_APP_REMOTINGNAME='vantage-nightly'
